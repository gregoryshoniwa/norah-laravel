  "item": [
    {
      "name": "InnBucks",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{INNBUCKS_KEY}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{INNBUCKS_USERNAME}}\",\n  \"password\": \"{{INNBUCKS_PASSWORD}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{INNBUCKS_URL}}/auth/third-party",
              "host": [
                "{{INNBUCKS_URL}}"
              ],
              "path": [
                "auth",
                "third-party"
              ]
            },
            "description": "Matches InnBucksPaymentService::login"
          }
        },
        {
          "name": "Create Payment Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{INNBUCKS_KEY}}",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{INNBUCKS_ACCESS_TOKEN}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"{{PHONE_NUMBER}}\",\n  \"total\": {{AMOUNT}},\n  \"currency\": \"{{CURRENCY}}\",\n  \"reference\": \"{{REFERENCE}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{INNBUCKS_URL}}/api/code/generate",
              "host": [
                "{{INNBUCKS_URL}}"
              ],
              "path": [
                "api",
                "code",
                "generate"
              ]
            },
            "description": "Matches InnBucksPaymentService::createPaymentRequest (expects bearer token from Login)."
          }
        },
        {
          "name": "Inquire Payment Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{INNBUCKS_KEY}}",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{INNBUCKS_ACCESS_TOKEN}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reference\": \"{{REFERENCE}}\",\n  \"code\": \"{{INNBUCKS_CODE}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{INNBUCKS_URL}}/api/code/inquiry",
              "host": [
                "{{INNBUCKS_URL}}"
              ],
              "path": [
                "api",
                "code",
                "inquiry"
              ]
            },
            "description": "Matches InnBucksPaymentService::inquirePaymentRequest."
          }
        }
      ]
    },
    {
      "name": "EcoCash",
      "item": [
        {
          "name": "Create Payment Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{ECOCASH_USERNAME}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{ECOCASH_PASSWORD}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientCorrelator\": \"{{ECOCASH_CLIENT_CORRELATOR}}\",\n  \"notifyUrl\": \"{{NOTIFY_URL}}\",\n  \"referenceCode\": \"{{REFERENCE}}\",\n  \"tranType\": \"MER\",\n  \"endUserId\": \"{{ECOCASH_PHONE_NUMBER}}\",\n  \"remarks\": \"Norah Payments\",\n  \"transactionOperationStatus\": \"Charged\",\n  \"paymentAmount\": {\n    \"charginginformation\": {\n      \"amount\": {{AMOUNT}},\n      \"currency\": \"{{CURRENCY}}\",\n      \"description\": \"Norah Online Payment\"\n    },\n    \"chargeMetaData\": {\n      \"channel\": \"WEB\",\n      \"purchaseCategoryCode\": \"Online Payment\",\n      \"onBeHalfOf\": \"Norah pgw\"\n    }\n  },\n  \"merchantCode\": \"{{ECOCASH_MERCHANT_CODE}}\",\n  \"merchantPin\": \"{{ECOCASH_MERCHANT_PIN}}\",\n  \"merchantNumber\": \"{{ECOCASH_MERCHANT_NUMBER}}\",\n  \"currencyCode\": \"{{CURRENCY}}\",\n  \"countryCode\": \"ZW\",\n  \"terminalID\": \"NORAH1\",\n  \"location\": \"194 Baines Avenue, Harare, Zimbabwe\",\n  \"superMerchantName\": \"NOARH\",\n  \"merchantName\": \"Noarh Payment Gateway\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{ECOCASH_URL}}/transactions/amount",
              "host": [
                "{{ECOCASH_URL}}"
              ],
              "path": [
                "transactions",
                "amount"
              ]
            },
            "description": "Matches EcoCashPaymentService::createPaymentRequest."
          }
        },
        {
          "name": "Inquire Payment Request",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{ECOCASH_USERNAME}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{ECOCASH_PASSWORD}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{ECOCASH_URL}}/{{ECOCASH_PHONE_NUMBER}}/transactions/amount/{{ECOCASH_CLIENT_CORRELATOR}}",
              "host": [
                "{{ECOCASH_URL}}"
              ],
              "path": [
                "{{ECOCASH_PHONE_NUMBER}}",
                "transactions",
                "amount",
                "{{ECOCASH_CLIENT_CORRELATOR}}"
              ]
            },
            "description": "Matches EcoCashPaymentService::inquirePaymentRequest."
          }
        }
      ]
    },
    {
      "name": "OMARI",
      "item": [
        {
          "name": "Auth Request (Send OTP)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Merchant-Key",
                "value": "{{OMARI_MERCHANT_KEY}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"msisdn\": \"{{OMARI_MSISDN}}\",\n  \"reference\": \"{{OMARI_REFERENCE}}\",\n  \"amount\": {{AMOUNT}},\n  \"currency\": \"{{CURRENCY}}\",\n  \"channel\": \"WEB\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{OMARI_URL}}/api/merchant/api/payment/auth",
              "host": [
                "{{OMARI_URL}}"
              ],
              "path": [
                "api",
                "merchant",
                "api",
                "payment",
                "auth"
              ]
            },
            "description": "Matches OmariPaymentService::createPaymentRequest auth endpoint."
          }
        },
        {
          "name": "Process OTP Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Merchant-Key",
                "value": "{{OMARI_MERCHANT_KEY}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"msisdn\": \"{{OMARI_MSISDN}}\",\n  \"reference\": \"{{OMARI_REFERENCE}}\",\n  \"otp\": \"{{OMARI_OTP}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{OMARI_URL}}/api/merchant/api/payment/request",
              "host": [
                "{{OMARI_URL}}"
              ],
              "path": [
                "api",
                "merchant",
                "api",
                "payment",
                "request"
              ]
            },
            "description": "Matches OmariPaymentService::processPayment."
          }
        },
        {
          "name": "Query Payment",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Merchant-Key",
                "value": "{{OMARI_MERCHANT_KEY}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{OMARI_URL}}/api/merchant/api/payment/query/{{OMARI_REFERENCE}}",
              "host": [
                "{{OMARI_URL}}"
              ],
              "path": [
                "api",
                "merchant",
                "api",
                "payment",
                "query",
                "{{OMARI_REFERENCE}}"
              ]
            },
            "description": "Matches OmariPaymentService::inquirePaymentRequest."
          }
        }
      ]
    },
    {
      "name": "ZimSwitch",
      "item": [
        {
          "name": "Create Checkout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ZIMSWITCH_AUTH_TOKEN}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded",
                "type": "text"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "entityId",
                  "value": "{{ZIMSWITCH_ENTITY_ID}}",
                  "type": "text"
                },
                {
                  "key": "amount",
                  "value": "{{AMOUNT}}",
                  "type": "text"
                },
                {
                  "key": "currency",
                  "value": "{{CURRENCY}}",
                  "type": "text"
                },
                {
                  "key": "paymentType",
                  "value": "DB",
                  "type": "text"
                },
                {
                  "key": "testMode",
                  "value": "EXTERNAL",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{ZIMSWITCH_URL}}/v1/checkouts",
              "host": [
                "{{ZIMSWITCH_URL}}"
              ],
              "path": [
                "v1",
                "checkouts"
              ]
            },
            "description": "Equivalent OPPWA checkout call used by Zimswitch integration."
          }
        },
        {
          "name": "Get Checkout Payment Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ZIMSWITCH_AUTH_TOKEN}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{ZIMSWITCH_URL}}/v1/checkouts/{{ZIMSWITCH_CHECKOUT_ID}}/payment?entityId={{ZIMSWITCH_ENTITY_ID}}",
              "host": [
                "{{ZIMSWITCH_URL}}"
              ],
              "path": [
                "v1",
                "checkouts",
                "{{ZIMSWITCH_CHECKOUT_ID}}",
                "payment"
              ],
              "query": [
                {
                  "key": "entityId",
                  "value": "{{ZIMSWITCH_ENTITY_ID}}"
                }
              ]
            },
            "description": "Matches ZimswitchPaymentService::getPaymentStatus."
          }
        },
        {
          "name": "Get Resource Path Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ZIMSWITCH_AUTH_TOKEN}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{ZIMSWITCH_URL}}{{ZIMSWITCH_RESOURCE_PATH}}?entityId={{ZIMSWITCH_ENTITY_ID}}",
              "host": [
                "{{ZIMSWITCH_URL}}"
              ],
              "path": [
                "{{ZIMSWITCH_RESOURCE_PATH}}"
              ],
              "query": [
                {
                  "key": "entityId",
                  "value": "{{ZIMSWITCH_ENTITY_ID}}"
                }
              ]
            },
            "description": "Matches ZimswitchPaymentService::checkPaymentStatus resourcePath flow."
          }
        }
      ]
    },
